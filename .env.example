# ==============================================================================
# Agence Ménage API (Django) — Modèle de variables d'environnement
# Copier ce fichier vers .env puis adapter les valeurs selon l'environnement.
# ==============================================================================

# --- Django Core ---
SECRET_KEY=change-me-in-production-with-a-long-random-secret
# True en local, False en production
DEBUG=True
# Optionnel : valeurs par défaut automatiques selon DEBUG (prod : api.agencemenage.ma)
ALLOWED_HOSTS=localhost,127.0.0.1,api.agencemenage.ma

# --- Base de données ---
# Laisser commenté pour SQLite en dev local, ou renseigner PostgreSQL en prod :
# DATABASE_URL=postgres://user:password@host:5432/dbname

# --- CORS & CSRF ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,https://agencemenage.ma,https://www.agencemenage.ma,https://app.agencemenage.ma,https://profil.agencemenage.ma,https://feedback.agencemenage.ma
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,https://agencemenage.ma,https://www.agencemenage.ma,https://app.agencemenage.ma,https://profil.agencemenage.ma,https://feedback.agencemenage.ma

# --- JWT Authentication ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- URLs Publiques ---
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# --- Emails (Resend) ---
RESEND_API_KEY=

# --- WhatsApp Business API (360Dialog) ---
D360_API_KEY=
D360_API_URL=https://waba-v2.360dialog.io/messages

# --- Stockage Médias S3 / Tigris (Obligatoire si DEBUG=False) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto
